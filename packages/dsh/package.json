{
  "name": "@ordarium/dsh",
  "version": "0.2.0",
  "description": "One-install DSH adapter for Ordarium Safe Actions",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./advanced": {
      "types": "./dist/src/advanced.d.ts",
      "import": "./dist/src/advanced.js"
    }
  },
  "dependencies": {
    "@ordarium/core": "workspace:*",
    "@ordarium/ledger-sqlite": "workspace:*"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
