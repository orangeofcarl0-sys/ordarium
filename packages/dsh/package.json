{
  "name": "@ordarium/dsh",
  "version": "1.3.2",
  "description": "[LEGACY] First DSH host adapter for Ordarium Safe Actions - frozen; prefer @ordarium/core with @ordarium/host-kit or @ordarium/host-mcp",
  "private": false,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./advanced": {
      "types": "./dist/src/advanced.d.ts",
      "import": "./dist/src/advanced.js"
    }
  },
  "dependencies": {
    "@ordarium/core": "workspace:*",
    "@ordarium/ledger-sqlite": "workspace:*"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "MIT",
  "files": [
    "dist/src"
  ]
}
